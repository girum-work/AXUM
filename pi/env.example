AXUM_CAMERA_HOST=0.0.0.0
AXUM_CAMERA_PORT=5001

# Leave both unset or set to "auto" to use the sensor's maximum resolution.
AXUM_CAPTURE_WIDTH=auto
AXUM_CAPTURE_HEIGHT=auto
AXUM_CAPTURE_JPEG_QUALITY=96

# Printed on the lens barrel, in millimetres (3.6 on the stock IR-CUT module).
# Set it and captures carry EXIF optics, so photogrammetry starts from the real
# focal length instead of a 45-degree guess. Sensor width is read from the
# sensor itself. Left unset no EXIF is written -- a wrong focal length is worse
# than none, because reconstruction would trust it.
#AXUM_LENS_FOCAL_MM=3.6

AXUM_STREAM_WIDTH=640
AXUM_STREAM_HEIGHT=480
AXUM_STREAM_FPS=10
AXUM_STREAM_JPEG_QUALITY=75
AXUM_CAMERA_WARMUP_SECONDS=2
AXUM_STREAM_STALE_SECONDS=5
AXUM_LOG_LEVEL=INFO
